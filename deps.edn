{:paths ["src"]
 ;; Reduced-order traction-motor solver on the shared, purpose-split libs.
 ;; Registers :rom-motor on the cae-solver contract; turns the design's peak-kW
 ;; assumption into a sized motor (torque density + efficiency). A high-fidelity
 ;; kami-emag magnetostatic FEA registers :emag-fea on the same contract later.
 :deps {io.github.kotoba-lang/datom       {:git/sha "d27a5833d59d909367956705f2ec931399c891ee"}
        io.github.kotoba-lang/cae-solver  {:git/sha "53e27f18ddcf10615a8a17adbb78018b1ab64a17"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :dev {:override-deps {io.github.kotoba-lang/datom       {:local/root "../datom"}
                        io.github.kotoba-lang/cae-solver  {:local/root "../cae-solver"}}}}}
